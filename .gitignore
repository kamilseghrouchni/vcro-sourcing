# Raw ingested documents (~99 MB; regeneratable from PMC + NCT IDs via
# scripts/pmc_convert.py and scripts/ct_convert.py — see README)
store/raw/

# Per-run extract fragments (regeneratable from raw/ via compile/extract)
store/runs/*/extract-fragments/

# Dev-only intermediate artifacts under store/queries/
store/queries/_dev_*

# Legacy v1 paths (kept here in case the v1 worktree is ever co-located)
store/sources/
store/cohorts/
store/index/

# Secrets
.notion-token
.openai-key
.env
*.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# macOS
.DS_Store

# Claude Code local settings (permissions, memory, scratch plans)
.claude/settings.local.json
.claude/projects/
.claude/plans/

# Node (for the future webapp at .claude/skills/nextjs-vercel-ai-webapp)
node_modules/
.next/
.vercel/
